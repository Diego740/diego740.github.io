---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Diego Aranda Gómez" description="La página que buscas no existe.">
  <main id="main" style="min-height:100svh;display:grid;place-items:center;padding:var(--gut);text-align:center">
    <div>
      <h1 class="name">404</h1>
      <p class="pos" style="margin:12px auto 24px">No hemos encontrado esa página. Puede que se haya movido.</p>
      <a class="btn btn-main" href="/">Volver al inicio</a>
    </div>
  </main>
</Base>
