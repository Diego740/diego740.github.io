---
import Base from './Base.astro';
import { ui } from '../i18n/ui.mjs';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title: string; description: string; lang: 'es' | 'en'; alternates: { es: string; en: string }; canonical?: string; ogType?: string; jsonld?: object | object[]; }
const { title, description, lang, alternates, canonical, ogType, jsonld } = Astro.props;
const t = ui[lang];
const other = lang === 'es' ? alternates.en : alternates.es;
const here = canonical ?? Astro.url.pathname;
---
<Base {title} {description} {lang} {alternates} {canonical} {ogType} {jsonld}>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="subtop">
    <a class="brand" href={t.home}>Diego Aranda Gómez</a>
    <nav class="subnav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul>
        {t.nav.map(([href, label]) => <li><a href={href} aria-current={here === href || here.startsWith(href + '/') ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <ThemeToggle {lang} />
      <a class="lang" data-setlang={lang === 'es' ? 'en' : 'es'} href={other} hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'} aria-label={t.langName}>{t.langLabel}</a>
    </nav>
  </header>
  <main id="main" class="page"><slot /></main>
  <footer class="foot">
    <p>© 2026 Diego Aranda Gómez</p>
    <ul>
      <li><a href="/geoalarm-privacy.html">{t.privacy[0]}</a></li>
      <li><a href="/mybudget-privacy.html">{t.privacy[1]}</a></li>
      <li><a href="/garagepad-privacy.html">{t.privacy[2]}</a></li>
    </ul>
  </footer>
</Base>
